<Window x:Class="KukaMcs.App.LogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MCS 실시간 로그" Width="1380" Height="850" MinWidth="900" MinHeight="550" WindowStartupLocation="CenterOwner">
  <Border Padding="14" Background="#F2F4F7"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="6"/><RowDefinition Height="4*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,10">
      <TextBlock Text="MCS / 실시간 로그" FontSize="21" FontWeight="Bold" Foreground="#F56600" Margin="0,0,0,10"/>
      <WrapPanel>
        <ComboBox x:Name="ModeCombo" Width="150" Margin="0,0,12,5" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="로그 종류"><ComboBoxItem Content="작업 메시지"/><ComboBoxItem Content="전체 SECS"/><ComboBoxItem Content="연결·시스템"/><ComboBoxItem Content="전체 로그"/></ComboBox>
        <TextBlock Text="COMMANDID" VerticalAlignment="Center" Margin="0,0,8,5"/>
        <TextBox x:Name="CommandFilterText" Width="300" Margin="0,0,12,5" TextChanged="Filter_Changed" ToolTip="COMMANDID 일부 또는 전체 입력. 빈칸은 모든 작업입니다." AutomationProperties.Name="로그 COMMANDID 필터"/>
        <CheckBox x:Name="LinkSelectionCheck" Content="작업 선택 연동" VerticalAlignment="Center" Margin="0,0,14,5" Checked="LinkSelection_Changed" Unchecked="LinkSelection_Changed"/>
        <CheckBox x:Name="FollowCheck" Content="새 메시지 따라가기" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,5"/>
        <CheckBox x:Name="WrapCheck" Content="원문 줄바꿈" VerticalAlignment="Center" Margin="0,0,14,5" Checked="Wrap_Changed" Unchecked="Wrap_Changed"/>
        <Button Content="원문 복사" Click="Copy_Click"/><Button Content="로그 폴더" Click="Folder_Click"/>
      </WrapPanel>
      <TextBlock x:Name="NavigationText" Margin="0,5,0,0" Foreground="#9B5700" TextWrapping="Wrap" Text="타임라인 행을 클릭하면 해당 원문으로 이동합니다."/>
    </StackPanel>
    <DataGrid Grid.Row="1" x:Name="MessagesGrid" SelectionChanged="Message_SelectionChanged" AutomationProperties.Name="별도 창 실시간 메시지"><DataGrid.Columns>
      <DataGridTextColumn Header="시각" Binding="{Binding Time, StringFormat={}{0:HH:mm:ss.fff}}" Width="105"/><DataGridTextColumn Header="방향" Binding="{Binding Direction}" Width="60"/>
      <DataGridTextColumn Header="메시지" Binding="{Binding MessageType}" Width="80"/><DataGridTextColumn Header="CEID" Binding="{Binding Ceid}" Width="65"/>
      <DataGridTextColumn Header="내용" Binding="{Binding Summary}" Width="*" MinWidth="240"/><DataGridTextColumn Header="COMMANDID" Binding="{Binding CommandId}" Width="280"/>
      <DataGridTextColumn Header="SystemBytes" Binding="{Binding SystemBytes, StringFormat=0x{0:X8}, TargetNullValue=''}" Width="110"/>
    </DataGrid.Columns><DataGrid.CellStyle><Style TargetType="DataGridCell"><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DCEBFF"/><Setter Property="Foreground" Value="#173B64"/></Trigger></Style.Triggers></Style></DataGrid.CellStyle></DataGrid>
    <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="#CBD2DC"/>
    <TextBox Grid.Row="3" x:Name="MessageBody" IsReadOnly="True" AcceptsReturn="True" VerticalContentAlignment="Top" FontFamily="Consolas, 맑은 고딕" FontSize="14" Background="#18222D" Foreground="#DBE5EF" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Text="메시지를 선택하면 원문이 표시됩니다." AutomationProperties.Name="별도 로그 원문"/>
    <TextBlock Grid.Row="4" x:Name="CountText" Foreground="#536174" Margin="0,8,0,0" TextWrapping="Wrap"/>
  </Grid></Border>
</Window>
