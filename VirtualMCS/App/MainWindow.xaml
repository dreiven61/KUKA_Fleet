<Window x:Class="KukaMcs.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="KUKA Virtual MCS" Width="1320" Height="940" MinWidth="1080" MinHeight="780" WindowStartupLocation="CenterScreen">
  <Grid Background="#F2F4F7">
    <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition x:Name="JobHistoryRow" Height="1.5*" /><RowDefinition Height="3.5*" /><RowDefinition Height="30" /></Grid.RowDefinitions>
    <Border Background="#202831" Padding="22,12">
      <Grid><StackPanel><TextBlock Foreground="#FF761F" FontWeight="Bold" FontSize="23" Text="KUKA  /  VIRTUAL MCS" /><TextBlock Foreground="#BEC8D4" FontSize="11" Text="SECS HOST   ·   KMP1500i / Fleet 자동 배차   ·   COMMANDID 자동 생성" Margin="1,4,0,0" /></StackPanel>
        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#35414F" CornerRadius="4" Padding="14,7"><TextBlock x:Name="ConnectionStateText" Text="DISCONNECTED" Foreground="White" FontWeight="SemiBold" /></Border>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="White" Margin="16,14,16,0" Padding="16" CornerRadius="5">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="82" /><ColumnDefinition Width="95" /><ColumnDefinition Width="130" /><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,12,0"><TextBlock Style="{StaticResource Label}" Text="Fleet IPv4 / Passive 바인딩 IP" /><TextBox x:Name="IpText" Text="192.168.0.45" AutomationProperties.Name="Fleet IP" /></StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Style="{StaticResource Label}" Text="Port" /><TextBox x:Name="PortText" Text="5556" AutomationProperties.Name="Port" /></StackPanel>
        <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Style="{StaticResource Label}" Text="Session ID" /><TextBox x:Name="DeviceText" Text="3000" AutomationProperties.Name="Session ID" /></StackPanel>
        <StackPanel Grid.Column="3" Margin="0,0,12,0"><TextBlock Style="{StaticResource Label}" Text="PC 연결 모드" /><ComboBox x:Name="ModeCombo" SelectedIndex="0" AutomationProperties.Name="PC 연결 모드"><ComboBoxItem Content="Active" /><ComboBoxItem Content="Passive" /></ComboBox></StackPanel>
        <StackPanel Grid.Column="4" Margin="0,0,12,0"><TextBlock Style="{StaticResource Label}" Text="T3 (초)" /><TextBox x:Name="TimeoutText" Text="120" AutomationProperties.Name="T3 초" /></StackPanel>
        <StackPanel Grid.Column="5" VerticalAlignment="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="ConnectButton" Content="연결" Click="Connect_Click" Style="{StaticResource Primary}" />
          <Button x:Name="DisconnectButton" Content="해제" Click="Disconnect_Click" IsEnabled="False" />
          <Button x:Name="EstablishButton" Content="S1F13" Click="Establish_Click" IsEnabled="False" ToolTip="통신 확립 요청. 연결 후 자동으로 한 번 실행됩니다." />
          <Button x:Name="OnlineButton" Content="S1F17" Click="Online_Click" IsEnabled="False" ToolTip="Online 요청" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="2" Background="White" Margin="16,12,16,0" Padding="16" CornerRadius="5">
      <StackPanel>
        <TextBlock Text="운송 명령 · 작업 포트 10개" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="150" /><ColumnDefinition Width="45" /><ColumnDefinition Width="150" /><ColumnDefinition Width="85" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,14,0"><TextBlock Style="{StaticResource Label}" Text="CARRIERID · 편집 가능" /><TextBox x:Name="CarrierText" Text="SIM_CARGO_001" TextChanged="Route_Changed" /></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource Label}" Text="FROM · 출발 포트" /><ComboBox x:Name="SourceCombo" SelectionChanged="Route_Changed" AutomationProperties.Name="출발 포트"></ComboBox></StackPanel>
          <Button Grid.Column="2" Content="⇄" Click="Swap_Click" Padding="1" Margin="7,21,7,0" ToolTip="방향 교환 (전송하지 않음)" AutomationProperties.Name="방향 교환" />
          <StackPanel Grid.Column="3"><TextBlock Style="{StaticResource Label}" Text="TO · 도착 포트" /><ComboBox x:Name="DestCombo" SelectionChanged="Route_Changed" AutomationProperties.Name="도착 포트"></ComboBox></StackPanel>
          <StackPanel Grid.Column="4" Margin="14,0,0,0"><TextBlock Style="{StaticResource Label}" Text="우선순위" /><TextBox x:Name="PriorityText" Text="1" TextChanged="Route_Changed" AutomationProperties.Name="우선순위" /></StackPanel>
          <StackPanel Grid.Column="5" VerticalAlignment="Bottom" HorizontalAlignment="Right" Orientation="Horizontal" Margin="16,0,0,0"><Button x:Name="ForwardButton" Content="89 → 97 전송" Click="Forward_Click" IsEnabled="False" /><Button x:Name="ReverseButton" Content="97 → 89 전송" Click="Reverse_Click" IsEnabled="False" /><Button x:Name="TransferButton" Content="선택 경로 전송" Click="Transfer_Click" IsEnabled="False" Style="{StaticResource Primary}" /></StackPanel>
        </Grid>
        <DockPanel Margin="0,12,0,0"><CheckBox x:Name="AutoSwapCheck" DockPanel.Dock="Right" Content="완료 보고 후 From/To 교환" IsChecked="True" VerticalAlignment="Center" /><StackPanel Orientation="Horizontal"><TextBlock Text="다음 COMMANDID   " Foreground="#657184" VerticalAlignment="Center" /><TextBox x:Name="CommandIdText" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Width="450" BorderThickness="0" Background="#F2F4F7" /></StackPanel></DockPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
          <Button x:Name="CancelButton" Content="선택 작업 CANCEL" Click="Cancel_Click" IsEnabled="False" ToolTip="픽업 전 취소. 결과 CEID204 확인이 필요합니다." />
          <Button x:Name="AbortButton" Content="선택 작업 ABORT" Click="Abort_Click" IsEnabled="False" ToolTip="실행 중인 운송을 강제로 중단합니다. 비상정지나 화물 자동 반납이 아닙니다." />
          <Button x:Name="PauseButton" Content="운송 PAUSE" Click="Pause_Click" IsEnabled="False" ToolTip="새 SECS 경로가 관리하는 운송 전체를 일시중지합니다." />
          <Button x:Name="ResumeButton" Content="운송 RESUME" Click="Resume_Click" IsEnabled="False" />
        </StackPanel>
        <TextBlock x:Name="HintText" Text="기존 Fleet 주소 192.168.0.45:5556을 사용합니다. 서버 수신부 전환 후 연결하세요." Foreground="#9B5700" Margin="0,10,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <Border x:Name="JobHistoryPanel" Grid.Row="3" Background="White" Margin="16,12,16,0" CornerRadius="5" Padding="12">
<DockPanel><Grid DockPanel.Dock="Top" Margin="4,0,0,8"><TextBlock Text="작업 이력 · 더블클릭하면 상세 열기" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><TextBlock x:Name="PendingText" Text="미확인 작업 0건" Foreground="#657184" VerticalAlignment="Center" Margin="0,0,15,0"/><Button Content="선택 작업 상세" Click="Details_Click"/><Button x:Name="ReleaseButton" Content="현장 확인 후 대기 해제" Click="Release_Click" ToolTip="로컬 전송 대기만 해제합니다. Fleet 작업을 취소하거나 완료시키지 않습니다."/></StackPanel></Grid>
<DataGrid x:Name="JobsGrid" SelectionChanged="Jobs_SelectionChanged" MouseDoubleClick="Jobs_DoubleClick" AutomationProperties.Name="작업 이력"><DataGrid.Columns>
<DataGridTextColumn Header="생성 시각" Binding="{Binding Time}" Width="95"/><DataGridTextColumn Header="상태" Binding="{Binding State}" Width="180"/><DataGridTextColumn Header="AGV" Binding="{Binding VehicleId}" Width="65"/><DataGridTextColumn Header="화물 ID" Binding="{Binding CarrierId}" Width="170"/><DataGridTextColumn Header="FROM → TO" Binding="{Binding Route}" Width="145"/><DataGridTextColumn Header="CEID" Binding="{Binding Ceid}" Width="55"/><DataGridTextColumn Header="결과" Binding="{Binding Result}" Width="50"/><DataGridTextColumn Header="COMMANDID" Binding="{Binding CommandId}" Width="270"/><DataGridTextColumn Header="상세" Binding="{Binding Detail}" Width="*" MinWidth="170"/>
</DataGrid.Columns><DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding State}" Value="완료 보고 수신"><Setter Property="Foreground" Value="#117045"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="상태 확인 필요"><Setter Property="Foreground" Value="#AD3F20"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle></DataGrid>
</DockPanel></Border>
<Border Grid.Row="4" Background="White" Margin="16,12,16,12" CornerRadius="5" Padding="10"><DockPanel>
<Grid DockPanel.Dock="Top" Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel Orientation="Horizontal" VerticalAlignment="Center"><CheckBox x:Name="SelectedJobOnlyCheck" Content="선택 작업만" Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="5,0,16,0"/><CheckBox x:Name="FollowMessagesCheck" Content="새 메시지 따라가기" IsChecked="True" Margin="0,0,16,0"/><TextBlock x:Name="MessageCountText" Foreground="#657184"/></StackPanel>
<StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="원문 크게 보기" Click="MessageWindow_Click" ToolTip="메시지 행을 더블클릭해도 원문 창이 열립니다."/><Button Content="로그 폴더" Click="Logs_Click"/><Button Content="화면 로그 지우기" Click="ClearLog_Click"/></StackPanel></Grid>
<TabControl SelectedIndex="1" x:Name="LogTabs" SelectionChanged="LogTab_Changed" BorderBrush="#DEE3E9">
<TabItem x:Name="CargoTab" Header=" 화물 입고·반출 "><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10">
<TextBlock Text="입고·반출은 Fleet 등록 상태를 변경합니다. AMR 이동이나 픽업·드롭 명령이 아닙니다." FontWeight="SemiBold"/>
<TextBlock Margin="0,4,0,0" Text="{Binding ElementName=CarrierText, Path=Text, StringFormat=대상 CARRIERID: {0} (위 운송 입력에서 편집)}"/>
<WrapPanel Margin="0,8,0,6">
<StackPanel Width="150" Margin="0,0,12,0"><TextBlock Style="{StaticResource Label}" Text="입출고 포트"/><ComboBox x:Name="CargoPortCombo"/></StackPanel>
<StackPanel Width="180" Margin="0,0,12,0"><TextBlock Style="{StaticResource Label}" Text="화물 모델"/><TextBox x:Name="CargoModelText" Text="SIM_TRAY_001"/></StackPanel>
<StackPanel Width="220" Margin="0,0,12,0"><TextBlock Style="{StaticResource Label}" Text="실제 스캔 ID · 수동 시험 입력"/><TextBox x:Name="ScannedIdText"/></StackPanel>
<CheckBox x:Name="ReadFailedCheck" Content="판독 실패 시험" VerticalAlignment="Bottom" Margin="0,0,12,8"/>
<CheckBox x:Name="DeleteCargoCheck" Content="반출 시 등록도 삭제" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
</WrapPanel>
<WrapPanel Margin="0,0,0,8"><CheckBox x:Name="PhysicalCargoCheck" Content="실제 반입·반출과 포트 위치를 확인함 (시뮬레이션은 가상 화물 배치 기준)" Margin="0,0,15,0"/>
<Button x:Name="CargoQueryButton" Content="Fleet 화물 조회" Click="CargoQuery_Click"/>
<Button x:Name="CargoInButton" Content="스캔 확인 후 입고" Click="CargoIn_Click"/>
<Button x:Name="CargoOutButton" Content="반출" Click="CargoOut_Click"/>
<Button x:Name="CargoScanButton" Content="ID 판독 보고 시험" Click="CargoScan_Click"/>
<Button x:Name="CargoVerifyButton" Content="선택 미확인 건 결과 재확인" Click="CargoVerify_Click"/>
</WrapPanel>
<TextBlock x:Name="InventoryTimeText" Text="조회 전 · 목록은 조회 시점의 Fleet 등록 정보입니다. 실제 스캐너는 아직 연결되지 않았습니다." Foreground="#9B5700" TextWrapping="Wrap"/>
<DataGrid x:Name="InventoryGrid" Height="135" Margin="0,6,0,5" SelectionChanged="Inventory_SelectionChanged"><DataGrid.Columns>
<DataGridTextColumn Header="CARRIERID · 선택하면 운송 입력에 반영" Binding="{Binding CarrierId}" Width="300"/>
<DataGridTextColumn Header="포트" Binding="{Binding Port}" Width="110"/><DataGridTextColumn Header="상태" Binding="{Binding State}" Width="120"/>
<DataGridTextColumn Header="모델" Binding="{Binding Model}" Width="160"/><DataGridTextColumn Header="Fleet 노드" Binding="{Binding Node}" Width="*"/>
</DataGrid.Columns></DataGrid>
<TextBlock Text="입출고 요청 이력 · HCACK 뒤 9001/9002 결과를 확인하세요. UNCERTAIN이면 재전송하지 마세요." TextWrapping="Wrap"/>
<DataGrid x:Name="CargoOperationsGrid" Height="130" Margin="0,6,0,0"><DataGrid.Columns>
<DataGridTextColumn Header="시각" Binding="{Binding Updated, StringFormat=HH:mm:ss}" Width="90"/><DataGridTextColumn Header="명령" Binding="{Binding Request.Command}" Width="160"/>
<DataGridTextColumn Header="화물" Binding="{Binding Request.CarrierId}" Width="170"/><DataGridTextColumn Header="결과" Binding="{Binding Outcome}" Width="140"/>
<DataGridTextColumn Header="상세" Binding="{Binding Detail}" Width="*"/><DataGridTextColumn Header="REQUESTID" Binding="{Binding Request.RequestId}" Width="240"/>
</DataGrid.Columns></DataGrid>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header=" 작업 메시지 "><Grid><Grid.RowDefinitions><RowDefinition Height="3*"/><RowDefinition Height="5"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
<DataGrid x:Name="WorkMessagesGrid" SelectionChanged="Message_SelectionChanged" MouseDoubleClick="Message_DoubleClick" AutomationProperties.Name="작업 메시지"><DataGrid.Columns>
<DataGridTextColumn Header="시각" Binding="{Binding Time}" Width="100"/><DataGridTextColumn Header="방향" Binding="{Binding Direction}" Width="55"/><DataGridTextColumn Header="메시지" Binding="{Binding MessageType}" Width="70"/><DataGridTextColumn Header="CEID" Binding="{Binding Ceid}" Width="55"/><DataGridTextColumn Header="내용" Binding="{Binding Summary}" Width="*" MinWidth="240"/><DataGridTextColumn Header="COMMANDID" Binding="{Binding CommandId}" Width="270"/><DataGridTextColumn Header="SystemBytes" Binding="{Binding SystemBytes}" Width="100"/>
</DataGrid.Columns><DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding Ceid}" Value="207"><Setter Property="Foreground" Value="#117045"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger><DataTrigger Binding="{Binding Ceid}" Value="208"><Setter Property="Foreground" Value="#155DA0"/></DataTrigger><DataTrigger Binding="{Binding Ceid}" Value="211"><Setter Property="Foreground" Value="#946000"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle></DataGrid>
<GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#DAE0E7"/>
<TextBox Grid.Row="2" x:Name="WorkMessageBody" IsReadOnly="True" VerticalContentAlignment="Top" FontFamily="Consolas, 맑은 고딕" FontSize="12" Background="#18222D" Foreground="#DBE5EF" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="작업 메시지 본문" Text="메시지 행을 선택하면 원문과 COMMANDID가 여기에 표시됩니다."/>
</Grid></TabItem>
<TabItem Header=" 전체 SECS "><Grid><Grid.RowDefinitions><RowDefinition Height="3*"/><RowDefinition Height="5"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
<DataGrid x:Name="AllMessagesGrid" SelectionChanged="Message_SelectionChanged" MouseDoubleClick="Message_DoubleClick" AutomationProperties.Name="전체 SECS"><DataGrid.Columns>
<DataGridTextColumn Header="시각" Binding="{Binding Time}" Width="100"/><DataGridTextColumn Header="방향" Binding="{Binding Direction}" Width="55"/><DataGridTextColumn Header="메시지" Binding="{Binding MessageType}" Width="70"/><DataGridTextColumn Header="CEID" Binding="{Binding Ceid}" Width="55"/><DataGridTextColumn Header="내용" Binding="{Binding Summary}" Width="*" MinWidth="240"/><DataGridTextColumn Header="COMMANDID" Binding="{Binding CommandId}" Width="270"/><DataGridTextColumn Header="SystemBytes" Binding="{Binding SystemBytes}" Width="100"/>
</DataGrid.Columns><DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding Ceid}" Value="207"><Setter Property="Foreground" Value="#117045"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger><DataTrigger Binding="{Binding Ceid}" Value="208"><Setter Property="Foreground" Value="#155DA0"/></DataTrigger><DataTrigger Binding="{Binding Ceid}" Value="211"><Setter Property="Foreground" Value="#946000"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle></DataGrid>
<GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#DAE0E7"/>
<TextBox Grid.Row="2" x:Name="AllMessageBody" IsReadOnly="True" VerticalContentAlignment="Top" FontFamily="Consolas, 맑은 고딕" FontSize="12" Background="#18222D" Foreground="#DBE5EF" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="전체 SECS 본문" Text="메시지 행을 선택하면 원문과 COMMANDID가 여기에 표시됩니다."/>
</Grid></TabItem>
<TabItem x:Name="JobDetailsTab" Header=" 작업 상세 "><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
<DockPanel Margin="0,0,14,0"><Button DockPanel.Dock="Bottom" Content="COMMANDID 복사" HorizontalAlignment="Left" Click="CopyCommandId_Click" Margin="0,8,0,0"/><TextBox x:Name="JobDetailsText" IsReadOnly="True" VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="#F3F6F9" Text="위 작업 이력에서 행을 선택하세요." AutomationProperties.Name="선택 작업 상세"/></DockPanel>
<DataGrid Grid.Column="1" x:Name="TimelineGrid" AutomationProperties.Name="작업 타임라인"><DataGrid.Columns><DataGridTextColumn Header="수신/기록 시각" Binding="{Binding Time}" Width="150"/><DataGridTextColumn Header="상태" Binding="{Binding State}" Width="175"/><DataGridTextColumn Header="CEID" Binding="{Binding Ceid}" Width="55"/><DataGridTextColumn Header="상세" Binding="{Binding Detail}" Width="*" MinWidth="200"/></DataGrid.Columns></DataGrid></Grid></TabItem>
<TabItem Header=" 연결·시스템 "><TextBox x:Name="LogText" IsReadOnly="True" VerticalContentAlignment="Top" TextWrapping="NoWrap" FontFamily="Consolas, 맑은 고딕" FontSize="12" Background="#18222D" Foreground="#DBE5EF" BorderThickness="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" AutomationProperties.Name="연결 시스템 로그"/></TabItem>
<TabItem Header=" S2F49 미리보기 "><TextBox x:Name="PreviewText" IsReadOnly="True" VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AcceptsReturn="True" AutomationProperties.Name="S2F49 미리보기"/></TabItem>
</TabControl></DockPanel></Border>
    <Border Grid.Row="5" Background="#E7EBF0" Padding="18,5"><DockPanel><TextBlock DockPanel.Dock="Right" Text="v2.1.1  ·  Secs4Net 3.1.0" Foreground="#657184" /><TextBlock x:Name="FooterText" Text="자동 재전송 없음 · S2F50만으로 운송 완료로 표시하지 않습니다." Foreground="#536174" FontSize="11" /></DockPanel></Border>
  </Grid>
</Window>
