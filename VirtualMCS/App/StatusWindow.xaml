<Window x:Class="KukaMcs.App.StatusWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MCS 접속 · 상태 조회 시험" Width="1320" Height="900" MinWidth="1050" MinHeight="720" WindowStartupLocation="CenterOwner">
  <Grid Background="#F2F4F7" Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="1.2*"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#202831" Padding="16,12" CornerRadius="5"><DockPanel><TextBlock x:Name="StateText" DockPanel.Dock="Right" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel><TextBlock Text="MCS / 접속 후 상태 조회 시험" Foreground="#FF761F" FontSize="22" FontWeight="Bold"/><TextBlock Text="S1F3 요청 → S1F4 응답 · AGV / 관리 포트 / 현재 작업" Foreground="#DBE5EF" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
    <Border Grid.Row="1" Background="White" Padding="12" Margin="0,12,0,0" CornerRadius="5"><StackPanel>
      <WrapPanel><Button x:Name="AgvButton" Content="AGV 조회 · SV25" Click="Agv_Click"/><Button x:Name="PortButton" Content="포트 조회 · SV58" Click="Port_Click"/><Button x:Name="TransferButton" Content="현재 작업 조회 · SV23" Click="Transfer_Click"/><Button x:Name="CarrierButton" Content="화물 조회 · SV21" Click="Carrier_Click"/><Button x:Name="CombinedButton" Content="4종 함께 조회" Click="Combined_Click"/><Button x:Name="AllButton" Content="전체 SVID 조회" Click="All_Click"/></WrapPanel>
      <WrapPanel Margin="0,6,0,0"><Button x:Name="StartupButton" Content="접속 패턴 1회 · 25→58→23" Click="Startup_Click"/><TextBlock Text="반복 묶음 수" VerticalAlignment="Center" Margin="12,0,6,0"/><TextBox x:Name="RepeatText" Text="100" Width="65" VerticalAlignment="Center" AutomationProperties.Name="상태 조회 반복 묶음 수"/><Button x:Name="BurstButton" Content="연속 요청 시험" Click="Burst_Click" Style="{StaticResource Primary}"/><Button x:Name="StopButton" Content="시험 중지" Click="Stop_Click" IsEnabled="False"/><Button Content="로그 폴더 열기" Click="Logs_Click"/><Button Content="선택 원문 복사" Click="Copy_Click"/></WrapPanel>
      <TextBlock Text="연속 요청 시험은 AGV·포트·작업 3개 요청을 응답 대기 없이 보냅니다. 다음 묶음은 3개 응답 확인 후 시작합니다. 운송은 발행하지 않습니다." Foreground="#657184" TextWrapping="Wrap" Margin="4,6,0,0"/>
      <TextBlock Text="SKI 사양 항목명 표시: VehicleID / VehicleState / CommandID / EnhancedTransfers · 원문의 [항목명]은 해석용이며 패킷에 추가되지 않습니다." Foreground="#536174" TextWrapping="Wrap" Margin="4,4,0,0"/>
    </StackPanel></Border>
    <Border Grid.Row="2" Background="#E7EBF0" Padding="12,8" Margin="0,10,0,0" CornerRadius="4"><StackPanel><TextBlock x:Name="ProgressText" Text="메인 화면에서 연결하세요. 접속 후 상태 조회가 선택돼 있으면 통신 확립 후 자동으로 3개 요청을 보냅니다." TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock x:Name="StatsText" Text="현재 시험: 수신 0 / 실패 0" Margin="0,4,0,0" Foreground="#536174"/></StackPanel></Border>
    <TabControl x:Name="SnapshotTabs" Grid.Row="3" Margin="0,10,0,0">
      <TabItem Header=" AGV · SV25 "><DockPanel><TextBlock x:Name="AgvTime" DockPanel.Dock="Top" Text="미조회" Margin="8"/><DataGrid x:Name="AgvGrid" AutoGenerateColumns="True" IsReadOnly="True"/></DockPanel></TabItem>
      <TabItem Header=" 관리 포트 · SV58 "><DockPanel><TextBlock x:Name="PortTime" DockPanel.Dock="Top" Text="미조회" Margin="8"/><DataGrid x:Name="PortGrid" AutoGenerateColumns="True" IsReadOnly="True"/></DockPanel></TabItem>
      <TabItem Header=" 현재 작업 · SV23 "><DockPanel><TextBlock x:Name="TransferTime" DockPanel.Dock="Top" Text="미조회 · 로컬 작업 이력과 별도인 Fleet 현재 목록" Margin="8"/><DataGrid x:Name="TransferGrid" AutoGenerateColumns="True" IsReadOnly="True"/></DockPanel></TabItem>
      <TabItem Header=" 화물 · SV21 "><DockPanel><TextBlock x:Name="CarrierTime" DockPanel.Dock="Top" Text="미조회" Margin="8"/><DataGrid x:Name="CarrierGrid" AutoGenerateColumns="True" IsReadOnly="True"/></DockPanel></TabItem>
    </TabControl>
    <Grid Grid.Row="4" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="Result_Changed" AutomationProperties.Name="상태 조회 시험 로그"><DataGrid.Columns><DataGridTextColumn Header="시각" Binding="{Binding TimeText}" Width="105"/><DataGridTextColumn Header="SVID" Binding="{Binding RequestIds}" Width="95"/><DataGridTextColumn Header="결과" Binding="{Binding ResultText}" Width="120"/><DataGridTextColumn Header="응답 시간" Binding="{Binding ElapsedText}" Width="100"/><DataGridTextColumn Header="내용" Binding="{Binding Summary}" Width="*" MinWidth="220"/></DataGrid.Columns></DataGrid>
      <TextBox x:Name="RawText" Grid.Column="2" IsReadOnly="True" VerticalContentAlignment="Top" FontFamily="Consolas, 맑은 고딕" FontSize="12" Background="#18222D" Foreground="#DBE5EF" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" AutomationProperties.Name="선택 S1F3 S1F4 원문"/>
    </Grid>
    <TextBlock Grid.Row="5" Text="목록은 각 수신 시점의 상태입니다. 단절·실패 시 이전 목록은 유효하지 않습니다. 조회 실패는 작업 없음이 아닙니다. 원문은 기존 MCS 로그 폴더에도 저장됩니다." Foreground="#9B5700" TextWrapping="Wrap" Margin="4,10,0,0"/>
  </Grid>
</Window>
